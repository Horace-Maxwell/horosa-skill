{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.horace-maxwell/horosa-skill",
  "title": "Horosa Skill",
  "description": "Local-first offline 术数/占星 (Horosa 星阙): 106 technique tools, all computed on your machine.",
  "version": "0.37.0",
  "websiteUrl": "https://github.com/Horace-Maxwell/horosa-skill",
  "repository": {
    "url": "https://github.com/Horace-Maxwell/horosa-skill",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "horosa-skill",
      "version": "0.37.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        },
        {
          "type": "positional",
          "value": "--transport"
        },
        {
          "type": "positional",
          "value": "stdio"
        }
      ],
      "environmentVariables": [
        {
          "name": "HOROSA_RUNTIME_ROOT",
          "description": "Offline runtime directory (default ~/.horosa/runtime or %LOCALAPPDATA%\\\\Horosa\\\\runtime)",
          "isRequired": false
        },
        {
          "name": "HOROSA_SKILL_DATA_DIR",
          "description": "Local runs / reports / SQLite directory (default ~/.horosa-skill)",
          "isRequired": false
        }
      ]
    },
    {
      "registryType": "mcpb",
      "identifier": "https://github.com/Horace-Maxwell/horosa-skill/releases/download/v0.37.0/horosa-skill-0.37.0.mcpb",
      "version": "0.37.0",
      "fileSha256": "",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "category": "knowledge-and-reasoning",
      "tags": [
        "mcp",
        "horosa",
        "xingque",
        "astrology",
        "metaphysics",
        "offline-first",
        "local-memory"
      ],
      "platforms": [
        "macOS",
        "Windows"
      ],
      "transports": [
        "stdio",
        "streamable-http"
      ],
      "install": [
        "uvx --from \"https://github.com/Horace-Maxwell/horosa-skill/releases/download/v0.37.0/horosa_skill-0.37.0-py3-none-any.whl\" horosa-skill install",
        "uvx --from \"git+https://github.com/Horace-Maxwell/horosa-skill@v0.37.0#subdirectory=horosa-skill\" horosa-skill install",
        "或源码：uv sync --dev && uv run horosa-skill install"
      ],
      "start": [
        "uvx --from \"https://github.com/Horace-Maxwell/horosa-skill/releases/download/v0.37.0/horosa_skill-0.37.0-py3-none-any.whl\" horosa-skill serve --transport stdio",
        "uvx --from \"git+https://github.com/Horace-Maxwell/horosa-skill@v0.37.0#subdirectory=horosa-skill\" horosa-skill serve --transport stdio",
        "或源码：uv run horosa-skill serve --transport stdio"
      ],
      "releaseManifest": "https://github.com/Horace-Maxwell/horosa-skill/releases/latest/download/runtime-manifest.json",
      "publish_blocked_until": "pypi trusted publisher (deferred by the maintainer)"
    }
  }
}
