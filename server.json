{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.horace-maxwell/horosa-skill",
  "title": "Horosa Skill",
  "description": "Local-first offline Horosa / Xingque MCP server with structured export contracts, bundled hover knowledge, local memory, and release-managed runtime payloads.",
  "version": "0.35.0",
  "websiteUrl": "https://github.com/Horace-Maxwell/horosa-skill",
  "repository": {
    "url": "https://github.com/Horace-Maxwell/horosa-skill",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "horosa-skill",
      "version": "0.35.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        },
        {
          "type": "positional",
          "value": "--transport"
        },
        {
          "type": "positional",
          "value": "stdio"
        }
      ],
      "environmentVariables": [
        {
          "name": "HOROSA_RUNTIME_ROOT",
          "description": "Offline runtime directory (default ~/.horosa/runtime or %LOCALAPPDATA%\\\\Horosa\\\\runtime)",
          "isRequired": false
        },
        {
          "name": "HOROSA_SKILL_DATA_DIR",
          "description": "Local runs / reports / SQLite directory (default ~/.horosa-skill)",
          "isRequired": false
        }
      ]
    }
  ],
  "_meta": {
    "io.github.horace-maxwell/horosa-skill": {
      "category": "knowledge-and-reasoning",
      "tags": [
        "mcp",
        "horosa",
        "xingque",
        "astrology",
        "metaphysics",
        "offline-first",
        "local-memory"
      ],
      "platforms": [
        "macOS",
        "Windows"
      ],
      "transports": [
        "stdio",
        "streamable-http"
      ],
      "install": [
        "uvx horosa-skill install",
        "或源码：uv sync --dev && uv run horosa-skill install"
      ],
      "start": [
        "uvx horosa-skill serve --transport stdio",
        "或源码：uv run horosa-skill serve --transport stdio"
      ],
      "releaseManifest": "https://github.com/Horace-Maxwell/horosa-skill/releases/latest/download/runtime-manifest.json"
    }
  }
}
